DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GLASSBOX_DB_PATH=.glassbox/glassbox.db
GLASSBOX_CONTEXT_CHAR_BUDGET=24000
GLASSBOX_RECENT_TURNS=4
GLASSBOX_MAX_STEPS=8
GLASSBOX_MAX_SESSION_TURNS=50
# turn: bind only the tools selected for each turn; all: compatibility fallback.
GLASSBOX_TOOL_BINDING_MODE=turn
# Demo only: make one named tool fail once with a retryable error.
GLASSBOX_FAIL_ONCE_TOOL=
